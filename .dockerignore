# gazetteer.yaml сознательно НЕ здесь: остаётся в образе как fallback на
# случай, если bind-mount в docker-compose.yml почему-то не настроен — в
# норме bind-mount поверх него всё равно единственный источник правды (на
# сервере его правят руками, см. CLAUDE.md).
