VK_TOKEN=
GROUP_ID=
ADMIN_ID=

# ОБЯЗАТЕЛЬНАЯ переменная: peer_id всех бесед, которые бот обслуживает,
# через запятую (для беседы это 2000000000 + номер беседы в сообществе).
# Сообщения из любой другой беседы игнорируются целиком — не читаются, не
# пишутся в базу и не получают ответа. Дефолта нет намеренно: пустое
# значение означало бы "любая беседа", поэтому бот просто не стартует.
ALLOWED_PEER_IDS=
AUTO_REPLY_ON_QUESTION=false
FRESH_MINUTES=240
STALE_MINUTES=480
MIN_REPLY_GAP_SECONDS=5

# Сроки жизни данных участников. Сам факт (станция, марка, статус, время)
# живёт вечно; истекают только сырой текст сообщения и идентификаторы.
RAW_TEXT_TTL_DAYS=30
PROCESSED_MESSAGE_TTL_DAYS=7
# Ключ для отпечатка автора. Пусто — берётся VK_TOKEN (он уже секретный и
# стабильный). Отпечатки нужны только чтобы отличать «тот же автор» от
# «другой», не зная, кто это; их никто не читает, так что смена ключа
# безопасна.
AUTHOR_HASH_SECRET=
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=10
LLM_PROVIDER=mistral
# Второй провайдер на случай, если основной не ответил — пробуется до
# отката на rule-based. Пусто — второй попытки нет. Резервный путь не
# пишет факты (см. ARCHITECTURE.md, «Что происходит, когда LLM не
# отвечает»), поэтому сбой основного провайдера без резерва означает
# потерянные отчёты.
LLM_FALLBACK_PROVIDER=

GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

MISTRAL_API_KEY=
# Датированная модель, не алиас "-latest" — на Mistral алиасы могут
# резолвиться в модель с заметно худшими лимитами (см. DEPLOY.md/
# ARCHITECTURE.md, тот же урок уже был на Gemini с gemini-flash-latest).
MISTRAL_MODEL=ministral-8b-2512

# SOCKS5-прокси (SSH-туннель на сайдкар ai-proxy) для исходящих вызовов
# Groq/Gemini — нужен, если прод-VPS геолоцирован в стране, откуда эти API
# недоступны напрямую (см. DEPLOY.md). Пусто — вызовы идут напрямую, как
# раньше. Имеет смысл только под Docker Compose (см. docker-compose.yml,
# сервис ai-proxy) — локально (venv, python bot.py) оставлять пустым.
AI_PROXY_URL=

# Адрес/пользователь/порт внешнего сервера для SSH-туннеля ai-proxy — читает
# только сервис ai-proxy в docker-compose.yml, не сам бот.
AI_PROXY_SSH_HOST=
AI_PROXY_SSH_USER=tunneluser
AI_PROXY_SSH_PORT=22
